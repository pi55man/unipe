# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# tauri (also covered by root **/target/)
/src-tauri/target/
/src-tauri/gen/
/src-tauri/WixTools/
/src-tauri/WixTools*/

# misc
.DS_Store
*.pem
*.key

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local alert dumps (curated public/*.jsonl is un-ignored in the root .gitignore)
*.jsonl
!public/**/*.jsonl
