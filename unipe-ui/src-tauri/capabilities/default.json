{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "allow-read-pipeline",
      "description": "read alerts/status written by the unipe python engine",
      "commands": {
        "allow": ["read_pipeline"]
      }
    }
  ]
}
